# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console: APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Security & Authentication Configuration
# Set a strong 256-bit random key for production JWT token signing:
JWT_SECRET=
# Optional comma-separated list of allowed origins (e.g. https://shore.edu,https://app.shore.edu):
CORS_ALLOWED_ORIGINS=
